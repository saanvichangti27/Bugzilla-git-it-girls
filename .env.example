# Supabase Configuration (Optional - falls back to in-memory DB if empty)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Auth Configuration
JWT_SECRET=super-secret-jwt-key-for-dev

# API Configuration
API_PREFIX=/api/v1

# GitHub Integration (Phase 2)
# Personal Access Token with repo scope (create issues, read repo)
GITHUB_PAT=ghp_your_pat_here
# The GitHub org or user that owns the target repo
GITHUB_REPO_OWNER=your-github-org-or-username
# The repo name (without owner prefix)
GITHUB_REPO_NAME=your-repo-name
# A random secret you set when configuring the webhook on GitHub
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your-random-secret-here
# Base URL of your frontend (used to build the bug link in GitHub issues)
APP_FRONTEND_URL=http://localhost:5173
