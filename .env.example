# Supabase Configuration (Optional - falls back to in-memory DB if empty)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Auth Configuration
JWT_SECRET=super-secret-jwt-key-for-dev

# API Configuration
API_PREFIX=/api/v1

# GitHub Integration (Phase 2)
GITHUB_PAT=ghp_your_pat_here
GITHUB_REPO_OWNER=your-github-org-or-username
GITHUB_REPO_NAME=your-repo-name
GITHUB_WEBHOOK_SECRET=your-random-secret-here
APP_FRONTEND_URL=http://localhost:5173

# Gemini AI Integration (Phase 3)
GEMINI_API_KEY=your-gemini-api-key-here
